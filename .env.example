# ============================================================
# Solana Meme Bot — Environment Variables
# Copy this to .env and fill in your values.
# JANGAN commit file .env yang sudah diisi!
# ============================================================

# Bot mode: PAPER (default) | DEVNET | LIVE
BOT_MODE=PAPER

# Solana RPC
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# Helius (WebSocket untuk deteksi pool baru)
HELIUS_API_KEY=
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=

# Birdeye
BIRDEYE_API_KEY=

# RugCheck
RUGCHECK_API_URL=https://api.rugcheck.xyz/v1

# Jupiter
JUPITER_API_URL=https://quote-api.jup.ag/v6

# Jito (anti-sandwich bundle)
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Wallet — PRIVATE KEY HANYA DI SINI, JANGAN hardcode di kode!
WALLET_PRIVATE_KEY=
